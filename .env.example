# Local Hermes Agent gateway (OpenAI-compatible API server).
# Start with: hermes gateway
# Default listens on http://127.0.0.1:8642
HERMES_BASE_URL=http://127.0.0.1:8642

# Optional. Must match API_SERVER_KEY in ~/.hermes/.env when auth is enabled.
HERMES_API_KEY=

# Model id advertised by the gateway (GET /v1/models → often "hermes-agent").
HERMES_MODEL=hermes-agent
