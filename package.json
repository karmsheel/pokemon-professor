{
  "name": "pokemon-professor",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('fs').mkdirSync('dist-electron/emulator',{recursive:true});require('fs').copyFileSync('electron/emulator/mgba-bridge.lua','dist-electron/emulator/mgba-bridge.lua')\"",
    "dev:web": "next dev -p 3848",
    "dev:electron": "npm run build:electron && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "electron": "^33.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
